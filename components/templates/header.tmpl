{{define "header"}}
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Gig home">Gig</a>
    {{if .User}}
    <nav class="header-actions" aria-label="Account">
      {{if .User.IsAdmin}}<a href="/admin">Admin</a>{{end}}
      {{if .User.IsSeller}}
      <a href="/sell">Selling</a>
      {{else}}
      <form method="post" action="/sell/start" class="inline-form">
        {{template "csrffield" .CSRF}}
        <button type="submit" class="link-button">Start selling</button>
      </form>
      {{end}}
      <a href="/dashboard">Dashboard</a>
      <a href="/account">Account</a>
      <form method="post" action="/logout" class="inline-form">
        {{template "csrffield" .CSRF}}
        <button type="submit" class="link-button">Log out</button>
      </form>
    </nav>
    {{else}}
    <nav class="header-actions" aria-label="Account">
      <a href="/login">Log in</a>
      <a class="btn btn-primary" href="/register">Sign up</a>
    </nav>
    {{end}}
  </div>
</header>
{{end}}
