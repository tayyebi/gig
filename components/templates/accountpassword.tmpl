{{define "accountpassword"}}
<section class="auth">
  <h1>Change your password</h1>
  {{template "errorsummary" .Errors}}
  <form method="post" action="/account/password" novalidate>
    {{template "csrffield" .CSRF}}
    <div class="field">
      <label for="{{fieldid "current_password"}}">Current password</label>
      <input id="{{fieldid "current_password"}}" name="current_password" type="password" autocomplete="current-password" required{{if .Errors.current_password}} aria-invalid="true" aria-describedby="{{fieldid "current_password"}}-error"{{end}}>
      {{if .Errors.current_password}}<p class="field-error" id="{{fieldid "current_password"}}-error">{{.Errors.current_password}}</p>{{end}}
    </div>
    <div class="field">
      <label for="{{fieldid "new_password"}}">New password</label>
      <input id="{{fieldid "new_password"}}" name="new_password" type="password" autocomplete="new-password" minlength="10" required{{if .Errors.new_password}} aria-invalid="true" aria-describedby="{{fieldid "new_password"}}-error"{{end}}>
      <p class="hint">At least 10 characters.</p>
      {{if .Errors.new_password}}<p class="field-error" id="{{fieldid "new_password"}}-error">{{.Errors.new_password}}</p>{{end}}
    </div>
    <div class="field">
      <label for="{{fieldid "new_password_confirm"}}">Confirm new password</label>
      <input id="{{fieldid "new_password_confirm"}}" name="new_password_confirm" type="password" autocomplete="new-password" required{{if .Errors.new_password_confirm}} aria-invalid="true" aria-describedby="{{fieldid "new_password_confirm"}}-error"{{end}}>
      {{if .Errors.new_password_confirm}}<p class="field-error" id="{{fieldid "new_password_confirm"}}-error">{{.Errors.new_password_confirm}}</p>{{end}}
    </div>
    <button class="btn btn-primary" type="submit">Update password</button>
  </form>
  <p class="muted"><a href="/account">Back to account</a></p>
</section>
{{end}}
