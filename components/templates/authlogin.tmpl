{{define "authlogin"}}
<section class="auth">
  <h1>Log in</h1>
  {{template "errorsummary" .Errors}}
  <form method="post" action="/login" novalidate>
    {{template "csrffield" .CSRF}}
    {{if .Next}}<input type="hidden" name="next" value="{{.Next}}">{{end}}
    <div class="field">
      <label for="{{fieldid "email"}}">Email</label>
      <input id="{{fieldid "email"}}" name="email" type="email" autocomplete="email" value="{{.Values.email}}" required{{if .Errors.email}} aria-invalid="true" aria-describedby="{{fieldid "email"}}-error"{{end}}>
      {{if .Errors.email}}<p class="field-error" id="{{fieldid "email"}}-error">{{.Errors.email}}</p>{{end}}
    </div>
    <div class="field">
      <label for="{{fieldid "password"}}">Password</label>
      <input id="{{fieldid "password"}}" name="password" type="password" autocomplete="current-password" required{{if .Errors.password}} aria-invalid="true" aria-describedby="{{fieldid "password"}}-error"{{end}}>
      {{if .Errors.password}}<p class="field-error" id="{{fieldid "password"}}-error">{{.Errors.password}}</p>{{end}}
    </div>
    <div class="field">
      <label for="{{fieldid "totp_code"}}">Authenticator code</label>
      <input id="{{fieldid "totp_code"}}" name="totp_code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]*"{{if .Errors.totp_code}} aria-invalid="true" aria-describedby="{{fieldid "totp_code"}}-error"{{end}}>
      <p class="hint">Required only if you have two-factor authentication enabled.</p>
      {{if .Errors.totp_code}}<p class="field-error" id="{{fieldid "totp_code"}}-error">{{.Errors.totp_code}}</p>{{end}}
    </div>
    <button class="btn btn-primary btn-block" type="submit">Log in</button>
  </form>
  <p class="muted"><a href="/forgot-password">Forgot your password?</a></p>
  <p class="muted">New here? <a href="/register">Create an account</a></p>
</section>
{{end}}
