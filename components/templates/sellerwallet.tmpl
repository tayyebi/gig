{{define "sellerwallet"}}
<section class="container">
  <h1>Payout wallets</h1>
  {{if not .Enabled}}
  <p>Wallet payouts are not enabled on this deployment yet.</p>
  {{else}}
  {{range .Wallets}}<p>{{.Asset}} {{.Network}}: wallet on file ({{.Status}})</p>{{end}}
  <h2>Add or change a wallet</h2>
  <p class="hint">Changing a wallet requires confirming it by email, and a {{.CooldownText}} cooling-off period after confirmation before it becomes payout-eligible.</p>
  <form method="post" action="/sell/wallet" novalidate>
    {{template "csrffield" .CSRF}}
    <div class="field">
      <label for="{{fieldid "network"}}">Network</label>
      <select id="{{fieldid "network"}}" name="network" required>
        <option value="base">Base</option>
        <option value="polygon">Polygon</option>
      </select>
    </div>
    <div class="field">
      <label for="{{fieldid "asset"}}">Asset</label>
      <select id="{{fieldid "asset"}}" name="asset" required>
        <option value="usdc">USDC</option>
        <option value="usdt">USDT</option>
      </select>
    </div>
    <div class="field">
      <label for="{{fieldid "address"}}">Wallet address</label>
      <input id="{{fieldid "address"}}" name="address" type="text" required pattern="0x[0-9a-fA-F]{40}" maxlength="42" placeholder="0x...">
    </div>
    <button class="btn btn-primary" type="submit">Submit wallet</button>
  </form>
  {{end}}
</section>
{{end}}
