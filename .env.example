# DATABASE_URL is required. Use the Docker Compose internal network when
# running the app in containers; use localhost when running from the host.
DATABASE_URL=postgres://gig:gig-dev-password@localhost:5432/gig?sslmode=disable

# Role dispatched by the binary entrypoint: web or worker.
APP_ROLE=web
ENVIRONMENT=dev
LOG_LEVEL=info
HTTP_ADDR=:8080
BASE_URL=http://localhost:8090

# Secrets. Replace with >=32 random bytes in any non-dev environment.
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-value
CSRF_SECRET=change-me-to-a-long-random-value

# Sessions
SESSION_COOKIE_NAME=gig_session
SESSION_TTL=24h
COOKIE_SECURE=false

# Storage
STORAGE_DIR=./data
UPLOAD_MAX_BYTES=52428800

# Database pool
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

# Job queue
JOB_POLL_INTERVAL=1s
JOB_CLAIM_TIMEOUT=5m
JOB_MAX_ATTEMPTS=5
JOB_STALE_THRESHOLD=10m
JOB_CONCURRENCY=4

# Lifecycle
SHUTDOWN_TIMEOUT=15s

# Integration tests (set when running store tests against a database)
# TEST_DATABASE_URL=postgres://gig:gig-dev-password@localhost:5432/gig?sslmode=disable
