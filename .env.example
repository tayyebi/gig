# DATABASE_URL is required. Use the Docker Compose internal network when
# running the app in containers; use localhost when running from the host.
DATABASE_URL=postgres://gig:gig-dev-password@localhost:5432/gig?sslmode=disable

# Role dispatched by the binary entrypoint: web or worker.
APP_ROLE=web
ENVIRONMENT=dev
LOG_LEVEL=info
HTTP_ADDR=:4099
BASE_URL=http://localhost:4099

# Secrets. Replace with >=32 random bytes in any non-dev environment.
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-value
CSRF_SECRET=change-me-to-a-long-random-value

# Sessions
SESSION_COOKIE_NAME=gig_session
SESSION_TTL=24h
COOKIE_SECURE=false

# Auth security
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW=15m
AUTH_TOKEN_TTL=24h
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT=15m
TOTP_SKEW=1

# Email. Without SMTP_HOST, mail is logged to stdout (development only).
EMAIL_FROM=Gig <no-reply@example.com>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=secret

# Storage. STORAGE_DIR is served publicly at /media/; PRIVATE_STORAGE_DIR
# (order deliveries, dispute evidence) is never mounted and only reachable
# through an authorization-checked handler.
STORAGE_DIR=./data
PRIVATE_STORAGE_DIR=./data-private
UPLOAD_MAX_BYTES=52428800

# Orders. PLATFORM_FEE_BPS is basis points (1000 = 10%). AUTO_ACCEPT_AFTER is
# how long a delivery waits for buyer action before auto-accepting.
PLATFORM_FEE_BPS=1000
AUTO_ACCEPT_AFTER=72h

# Payments (Stripe Connect). Leave PAYMENTS_ENABLED=false to run checkout
# without a real provider (orders stay in pending_payment). Never commit real
# Stripe keys; get them from the Stripe dashboard for the target account.
PAYMENTS_ENABLED=false
PAYMENT_CURRENCY=usd
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
PAYMENT_RECONCILE_INTERVAL=15m

# BTCPay Server (Bitcoin/Lightning). Optional; leave unset to disable that
# checkout method.
BTCPAY_URL=
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=
BTCPAY_REQUIRED_CONFIRMATIONS=1

# EVM stablecoins (Base / Polygon). Optional per chain; leave a chain's
# RPC URL unset to disable it. Contract/treasury addresses are config-only,
# never taken from user input.
EVM_BASE_RPC_URL=
EVM_BASE_CHAIN_ID=8453
EVM_BASE_TREASURY_ADDRESS=
EVM_BASE_USDC_CONTRACT=
EVM_BASE_USDT_CONTRACT=
EVM_POLYGON_RPC_URL=
EVM_POLYGON_CHAIN_ID=137
EVM_POLYGON_TREASURY_ADDRESS=
EVM_POLYGON_USDC_CONTRACT=
EVM_POLYGON_USDT_CONTRACT=
EVM_REQUIRED_CONFIRMATIONS=12

# Seller wallet payouts. WALLET_ENCRYPTION_KEY must be a base64-encoded
# 32-byte AES-256 key (e.g. `openssl rand -base64 32`); required once any
# EVM chain above is configured in production.
WALLET_ENCRYPTION_KEY=
WALLET_CHANGE_COOLDOWN=24h

# Database pool
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

# Job queue
JOB_POLL_INTERVAL=1s
JOB_CLAIM_TIMEOUT=5m
JOB_MAX_ATTEMPTS=5
JOB_STALE_THRESHOLD=10m
JOB_CONCURRENCY=4

# Lifecycle
SHUTDOWN_TIMEOUT=15s

# Integration tests (set when running store tests against a database)
# TEST_DATABASE_URL=postgres://gig:gig-dev-password@localhost:5432/gig?sslmode=disable
